{
  "name": "Gabay Earthy Minimal Liquid Glass Design Tokens",
  "version": "1.0.0",
  "colors": {
    "primary": {
      "forestSlate": "#2E3A2F",
      "forestObsidian": "#141A15",
      "forestGlassDark": "#D01C251E"
    },
    "secondary": {
      "mutedSage": "#6B7F5B"
    },
    "tertiary": {
      "warmSand": "#D9C9B2"
    },
    "accent": {
      "terracotta": "#C96F4F",
      "terracottaEmber": "#E87A54"
    },
    "background": {
      "alabasterLinen": "#F8F6EE",
      "alabasterGlass": "#F2F8F6EE"
    },
    "borders": {
      "glassBorderDark": "#3BD9C9B2",
      "glassBorderLight": "#55D9C9B2"
    }
  },
  "typography": {
    "fontFamily": "San Francisco, Inter, sans-serif",
    "scale": {
      "caption": "10sp",
      "label": "12sp",
      "body": "14sp",
      "headline": "17sp",
      "title": "24sp",
      "speedometer": "32sp"
    }
  },
  "components": {
    "iosLiquidToggle": {
      "width": "51dp",
      "height": "31dp",
      "knobDiameter": "27dp",
      "knobElevation": "3dp",
      "knobOffsetActive": "20dp",
      "springDamping": 0.82,
      "springStiffness": 450.0
    },
    "splashScreen": {
      "nativeSuppression": "@drawable/splash_blank",
      "backgroundColor": "#141A15",
      "transition": "Expanding circular liquid ripple with Terracotta & Warm Sand wavefront"
    }
  }
}
